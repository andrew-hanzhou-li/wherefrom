{
  "manifest_version": 3,
  "name": "wherefrom",
  "version": "0.2.0",
  "description": "Tells the wherefrom program where each download came from, so you can look it up later.",
  "permissions": ["downloads", "nativeMessaging"],
  "background": { "scripts": ["background.js"] },
  "browser_specific_settings": { "gecko": { "id": "wherefrom@andrew-hanzhou-li.github.io", "strict_min_version": "115.0" } }
}
