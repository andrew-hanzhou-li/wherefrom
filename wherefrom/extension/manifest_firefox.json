{
  "manifest_version": 3,
  "name": "wherefrom",
  "version": "0.4.0",
  "description": "Tells the wherefrom program on your computer where each download came from, so you can look it up later. Requires wherefrom.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "wherefrom",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "scripts": [
      "logic.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wherefrom@andrew-hanzhou-li.github.io",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
