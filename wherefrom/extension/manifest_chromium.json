{
  "manifest_version": 3,
  "name": "wherefrom",
  "version": "0.2.0",
  "description": "Tells the wherefrom program where each download came from, so you can look it up later.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "downloads",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "key": ""
}
